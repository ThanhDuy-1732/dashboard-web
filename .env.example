# Neon Postgres (pooled connection string)
DATABASE_URL=

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HUB_NAME=Ecosystem Hub

# Admin (required; at least 12 characters; placeholders are rejected in production)
